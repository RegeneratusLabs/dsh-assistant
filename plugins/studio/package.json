{
  "name": "@local/dsh-studio",
  "version": "0.1.0",
  "private": true,
  "description": "The studio: an English-first design skill for the personal assistant — HTML prototypes, decks, motion, data visuals and critique, with PDF/PPTX export.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "store.js",
    "tools.js",
    "export.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "skill"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "playwright": "1.65.0",
    "pptxgenjs": "4.0.1"
  }
}
