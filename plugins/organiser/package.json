{
  "name": "@local/dsh-organiser",
  "version": "0.1.0",
  "private": true,
  "description": "The organiser: plans and notes kept locally, events read from a connected Google Calendar, one day view and one month view.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "store.js",
    "tools.js",
    "time.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
